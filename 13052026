#include <iostream>
#include <map>
#include <vector>
#include <string>
#include <set>
#include <queue>

using namespace std;

int main()
{
	setlocale(LC_ALL, "Rus");
	int k = 0;
	string n;
	map<char, int> m;
	vector<string> s = { "ПАРК","КАРП","СОН" ,"НОС" ,"ДЕНЬ" };
	queue <string> que;
	set<map<char, int>> set;
	for (int i = 0; i != size(s); i++)
	{
		que.push(s[i]);
	}
	while (!que.empty())
	{
		n = que.front();
		que.pop();
		m.clear();
		k = size(set);
		for (int j = 0; j != n.size(); j++)
		{
			++m[n[j]];
		}
		set.insert(m);
		if (size(set) > k) {
			cout << n << " ";
		}
	}
}


#include <iostream> 
