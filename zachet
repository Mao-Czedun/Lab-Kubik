using namespace std;

struct Node {
    int data;
    Node* next;
    Node(int val) : data(val), next(nullptr) {}
};

struct DNode {
    int data;
    DNode* prev;
    DNode* next;
    DNode(int val) : data(val), prev(nullptr), next(nullptr) {}
};

struct TreeNode {
    int data;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int val) : data(val), left(nullptr), right(nullptr) {}
};

bool Perfect(int n) {
    if (n <= 1) return false;
    int sum = 1;
    for (int i = 2; i * i <= n; ++i) {
        if (n % i == 0) {
            sum += i;
            if (i != n / i) sum += n / i;
        }
    }
    return sum == n;
}

void task1() {
    cout << "--------------------------------------------------\n";
    cout << "Задача 1. Дано два однонаправленных списка целых чисел.\n";
    cout << "Сформировать третий список, содержащий совершенные числа исходных списков.\n\n";

    vector<int> A = { 6, 8, 28, 12, 496, 5, 28 };
    vector<int> B = { 10, 8128, 5, 6, 7, 28 };

    Node* headA = nullptr, * tA = nullptr;
    for (int i : A)
    {
        Node* node = new Node(i);
        if (!headA) { 
            headA = node;
            tA = node;
        }
        else { 
            tA->next = node; 
            tA = node; 
        }
    }
    Node* headB = nullptr, * tB = nullptr;
    for (int i : B)
    {
        Node* node = new Node(i);
        if (!headB) {
            headB = node;
            tB = node;
        }
        else { 
            tB->next = node; tB = node;
        }
    }

    cout << "Входные данные:\n";
    cout << "  Первый список:  ";
    for (Node* p = headA; p; p = p->next)
    {
        cout << p->data << " ";
    }
    cout << "\n  Второй список:   ";
    for (Node* p = headB; p; p = p->next)
    {
        cout << p->data << " ";
    }
    cout << "\n";

    Node* headC = nullptr, * tC = nullptr;

    auto addToList = [&](Node*& head, Node*& tail, int val) {
        Node* node = new Node(val);
        if (!head) head = tail = node;
        else { tail->next = node; tail = node; }
        };

    for (Node* p = headA; p; p = p->next) {
        if (Perfect(p->data)) addToList(headC, tC, p->data);
    }
    for (Node* p = headB; p; p = p->next) {
        if (Perfect(p->data)) addToList(headC, tC, p->data);
    }

    cout << "Результат (совершенные числа):\n  ";
    for (Node* p = headC; p; p = p->next) cout << p->data << " ";
    cout << "\n--------------------------------------------------\n\n";
}

void task2() {
    cout << "--------------------------------------------------\n";
    cout << "Задача 2. Дан двунаправленный список целых чисел.\n";
    cout << "Переставить элементы так, чтобы сначала шли числа меньше среднего арифметического,\n";
    cout << "а затем – числа больше среднего. Элементы, равные среднему, остаются на месте.\n\n";

    vector<int> v = { 5, 2, 8, 3, 9, 1, 7, 5 };
    DNode* head = nullptr, * tail = nullptr;
    for (int i : v) 
    {
        DNode* node = new DNode(i);
        if (!head) head = tail = node;
        else {
            tail->next = node;
            node->prev = tail;
            tail = node;
        }
    }

    cout << "Входные данные (двунаправленный список):\n  ";
    for (DNode* p = head; p; p = p->next) {
        cout << p->data << " ";
    }
    cout << "\n";

    double sum = 0;
    int c = 0;
    for (DNode* p = head; p; p = p->next) 
    {
        sum += p->data; ++c; 
    }
    double sra = sum / c;

    vector<int> me, be;
    for (DNode* p = head; p; p = p->next) 
    {
        if (p->data < sra) 
        {
            me.push_back(p->data);
        }
        else {
            be.push_back(p->data);
        }
    }

    DNode* cur = head;
    for (int i : me) 
    {
        if (cur) 
        {
            cur->data = i;
            cur = cur->next;
        }
    }
    vector<int> ser;
    for (int i : v) 
    {
        if (i == sra) 
        {
            ser.push_back(i);
        }
    }
    for (int i : ser) 
    {
        if (cur) 
        {
            cur->data = i; cur = cur->next; 
        }
    }
    for (int i : be)
    {
        if (cur) 
        { 
            cur->data = i; cur = cur->next; 
        }
    }

    cout << "Результат (среднее арифметическое = " << sra << "):\n  ";
    for (DNode* p = head; p; p = p->next)
    {
        cout << p->data << " ";
    }
    cout << "\n--------------------------------------------------\n";
}



void insert(TreeNode*& root, int val) {
    if (!root) { 
        root = new TreeNode(val);
        return; 
    }
    if (val < root->data) {
        insert(root->left, val);
    }
    else {
        insert(root->right, val);
    }
}

void collectLeaves(TreeNode* node, vector<int>& le) {
    if (!node) return;
    if (!node->left && !node->right) {
        le.push_back(node->data);
        return;
    }
    collectLeaves(node->left, le);
    collectLeaves(node->right, le);
}

int count(TreeNode* node, double sre) {
    if (!node) return 0;
    int c;
    if (node->data < sre) c = 1;
    else c = 0;
    c += count(node->left, sre);
    c += count(node->right, sre);
    return c;
}

void task3() {
    cout << "--------------------------------------------------\n";
    cout << "Задача 3. Дано дерево двоичного поиска.\n";
    cout << "Найти количество элементов дерева, меньших среднего арифметического листьев.\n\n";

    vector<int> A = { 10, 5, 15, 3, 7, 12, 18 };
    TreeNode* root = nullptr;
    for (int i : A) insert(root, i);

    cout << "Входные данные (элементы дерева):\n  ";
    for (int i : A) cout << i << " ";
    cout << "\n\n";

    vector<int> list;
    collectLeaves(root, list);
    double sum = 0;
    for (int i : list) {
        sum += i;
    }
    double avg;
    if (list.empty()) {
        avg = 0;
    }
    else {
        avg = sum / list.size();
    }

    int lessCount = count(root, avg);

    cout << "Листья: ";
    for (int i : list) cout << i << " ";
    cout << "\nСреднее арифметическое листьев: " << avg;
    cout << "\nКоличество элементов меньше среднего: " << lessCount << "\n";
    cout << "--------------------------------------------------\n\n";
}

void task4() {
    cout << "--------------------------------------------------\n";
    cout << "Задача 4. Дан файл f, компонентами которого являются целые числа.\n";
    cout << "Переписать в файл g сначала все четные, потом все нечетные компоненты файла f.\n";

    const char* f = "f.txt";
    const char* g = "g.txt";

    vector<int> A = { 4, 7, 2, 9, 12, 5, 8, 3, 10 };
    {
        ofstream fo(f);
        for (int i : A) fo << i << " ";
    }

    cout << "Входные данные (файл f):\n  ";
    for (int i : A) cout << i << " ";
    cout << "\n";

    ifstream fin(f);
    vector<int> chet, nchet;
    int num;
    while (fin >> num) {
        if (num % 2 == 0) chet.push_back(num);
        else nchet.push_back(num);
    }
    fin.close();

    ofstream gout(g);
    for (int i : chet) {
        gout << i << " ";
    }
    for (int i : nchet) {
        gout << i << " ";
    }
    gout.close();

    cout << "Результат (файл g):\n  ";
    for (int i : chet) {
        cout << i << " ";
    }
    for (int i : nchet)  {
        cout << i << " ";}
    cout << "\n--------------------------------------------------\n";
}


void task5() {
    cout << "--------------------------------------------------\n";
    cout << "Задача 5. Даны действительные числа a1, a2, ..., an.\n";
    cout << "Оставить без изменения, если последовательность упорядочена по не убыванию\n";
    cout << "или не возрастанию. Иначе удалить элементы, порядковые номера которых кратны 4.\n";

    vector<double> seq = { 2, 0.5, 28, 91, 74, 66, 50, 89, 44, 2.4, 33, 77 };
    cout << "Входные данные:\n  ";
    size_t i = 0;
    while (i < seq.size()) {
        cout << seq[i];
        if (++i < seq.size()) cout << ", ";
    }
    cout << "\n";

    bool nub = true, nvoz = true;
    for (size_t i = 1; i < seq.size(); ++i) {
        if (seq[i - 1] > seq[i]) nub = false;
        if (seq[i - 1] < seq[i]) nvoz = false;
    }

    vector<double> res;
    if (nub || nvoz) {
        res = seq;
        cout << "Последовательность упорядочена. Изменений нет.\n";
    }
    else {
        cout << "Последовательность не упорядочена. Удаляем элементы с номерами, кратными 4.\n";
        for (size_t i = 0; i < seq.size(); ++i) {
            if ((i + 1) % 4 != 0) res.push_back(seq[i]);
        }
    }

    cout << "Результат:\n  ";
    for (size_t i = 0; i < res.size(); ++i)
        cout << res[i] << (i != res.size() - 1 ? ", " : "");
    cout << "\n--------------------------------------------------\n\n";
}

